go 1.27.2

// The repository has no module at its root. Each directory below contains
// the module of one concern of the runtime, and every ergon per-module
// command iterates the list.
use (
	./conform
	./fault
	./stub
)

// The go command reads the go.mod of each version of a module of the
// workspace that another module requires. fault has no published version
// yet, so the workspace replaces the version that stub requires by the
// directory of fault.
replace go.dokimi.dev/fault v0.0.0-00010101000000-000000000000 => ./fault
