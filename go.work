go 1.27.2

// The repository has no module at its root. Each directory below contains
// the module of one concern of the runtime, and every ergon per-module
// command iterates the list.
use (
	./conform
	./fault
	./host
	./medium
	./sim
	./spec
	./stub
)

replace go.dokimi.dev/fault v0.2.4 => ./fault

replace go.dokimi.dev/medium v0.2.1 => ./medium

replace go.dokimi.dev/spec v0.5.1 => ./spec

replace go.dokimi.dev/conform v0.16.3 => ./conform

replace go.dokimi.dev/host v0.2.1 => ./host
